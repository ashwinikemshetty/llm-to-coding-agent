{
  "name": "llm-to-coding-agent",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive journey from a bare LLM to a coding agent, for frontend engineers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "agent:0": "node agent/step-0-complete.ts",
    "agent:1": "node agent/step-1-chat.ts",
    "agent:2": "node agent/step-2-memory.ts",
    "agent:3": "node agent/step-3-context.ts",
    "agent:4": "node agent/step-4-tools.ts",
    "agent:5": "node agent/step-5-loop.ts",
    "agent:6": "node agent/step-6-coding-agent.ts",
    "agent:7": "node agent/step-7-production.ts",
    "agent:test": "node --test agent/project/cart.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
